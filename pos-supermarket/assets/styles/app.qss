/* ============================================================
   MOKAT MARKET POS — Vercel-Style Design System
   
   Palette (Light Mode):
     Primary:    #000000 (Black)
     Accent:     #0070F3 (Vercel Blue)
     Success:    #50E3C2 (Teal)
     Warning:    #F5A623 (Amber)
     Danger:     #EE0000 (Red)
     
     Background: #FAFAFA
     Surface:    #FFFFFF
     Border:     #EAEAEA
     
     Text:       #000000
     Text Muted: #666666
     Text Light: #888888
   ============================================================ */

/* ── Global Reset ───────────────────────────────────────────── */
* {
    margin: 0;
    padding: 0;
}

QWidget {
    background-color: #FAFAFA;
    color: #000000;
    font-family: "Inter", "Segoe UI", -apple-system, sans-serif;
    font-size: 14px;
    selection-background-color: #D3E5FF;
    selection-color: #000000;
}

QMainWindow, QDialog {
    background-color: #FAFAFA;
}

/* ── Scrollbars — Minimal ───────────────────────────────────── */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #D4D4D4;
    border-radius: 4px;
    min-height: 40px;
}
QScrollBar::handle:vertical:hover {
    background: #A3A3A3;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #D4D4D4;
    border-radius: 4px;
    min-width: 40px;
}
QScrollBar::handle:horizontal:hover {
    background: #A3A3A3;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* ── Typography ─────────────────────────────────────────────── */
QLabel#PageTitle {
    font-size: 24px;
    font-weight: 700;
    color: #000000;
    letter-spacing: -0.5px;
}

QLabel#SectionTitle {
    font-size: 12px;
    font-weight: 600;
    color: #666666;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

/* ── Cards — Clean Borders ──────────────────────────────────── */
QFrame#Card {
    background: #FFFFFF;
    border: 1px solid #EAEAEA;
    border-radius: 12px;
}

QGroupBox {
    background: #FFFFFF;
    border: 1px solid #EAEAEA;
    border-radius: 12px;
    margin-top: 16px;
    padding: 20px 16px 16px 16px;
    font-weight: 600;
    color: #000000;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    top: -2px;
    padding: 0 8px;
    color: #666666;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: #FFFFFF;
}

/* ── Buttons — Vercel Style ─────────────────────────────────── */
QPushButton {
    background-color: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 500;
    min-height: 40px;
}
QPushButton:hover {
    background-color: #333333;
}
QPushButton:pressed {
    background-color: #1A1A1A;
}
QPushButton:disabled {
    background-color: #EAEAEA;
    color: #A3A3A3;
}

/* Secondary / Outlined */
QPushButton#SecondaryButton {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #EAEAEA;
}
QPushButton#SecondaryButton:hover {
    background-color: #FAFAFA;
    border-color: #D4D4D4;
}

/* Ghost button */
QPushButton#GhostButton {
    background-color: transparent;
    color: #666666;
    border: none;
}
QPushButton#GhostButton:hover {
    background-color: #F5F5F5;
    color: #000000;
}

/* Danger */
QPushButton#DangerButton {
    background-color: #EE0000;
}
QPushButton#DangerButton:hover {
    background-color: #CC0000;
}

/* Success */
QPushButton#SuccessButton {
    background-color: #000000;
    border: 2px solid #50E3C2;
}
QPushButton#SuccessButton:hover {
    background-color: #1A1A1A;
}

/* Blue accent */
QPushButton#BlueButton {
    background-color: #0070F3;
}
QPushButton#BlueButton:hover {
    background-color: #0060D0;
}

/* ── Inputs — Clean Style ────────────────────────────────────── */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTextEdit {
    background: #FFFFFF;
    border: 1px solid #EAEAEA;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
    color: #000000;
    min-height: 40px;
}
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover {
    border-color: #D4D4D4;
}
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTextEdit:focus {
    border: 2px solid #000000;
    background: #FFFFFF;
}
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    background: #FAFAFA;
    color: #A3A3A3;
    border-color: #EAEAEA;
}
QLineEdit::placeholder {
    color: #A3A3A3;
}

/* Search input */
QLineEdit#SearchInput {
    padding-left: 40px;
    border-radius: 8px;
    background-color: #FFFFFF;
    border: 1px solid #EAEAEA;
}
QLineEdit#SearchInput:focus {
    border-color: #000000;
}

QComboBox::drop-down {
    border: none;
    padding-right: 12px;
    width: 24px;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #EAEAEA;
    border-radius: 8px;
    selection-background-color: #F5F5F5;
    selection-color: #000000;
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 10px 14px;
    border-radius: 4px;
    min-height: 36px;
}
QComboBox QAbstractItemView::item:hover {
    background: #F5F5F5;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button,
QDateEdit::up-button,
QDateEdit::down-button {
    border: none;
    background: transparent;
    width: 20px;
}

/* ── Tables — Clean Grid ─────────────────────────────────────── */
QTableWidget {
    background: #FFFFFF;
    border: 1px solid #EAEAEA;
    border-radius: 8px;
    gridline-color: #EAEAEA;
    alternate-background-color: #FAFAFA;
    selection-background-color: #F5F5F5;
    selection-color: #000000;
    font-size: 14px;
    outline: none;
}
QTableWidget::item {
    padding: 12px 16px;
    border: none;
    border-bottom: 1px solid #EAEAEA;
}
QTableWidget::item:selected {
    background-color: #F5F5F5;
    color: #000000;
}
QTableWidget::item:hover {
    background-color: #FAFAFA;
}

QHeaderView::section {
    background-color: #FFFFFF;
    color: #666666;
    border: none;
    border-bottom: 1px solid #EAEAEA;
    padding: 14px 16px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QTableWidget QTableCornerButton::section {
    background: #FFFFFF;
    border: none;
}

/* ── Sidebar — Light Vercel Style ────────────────────────────── */
QListWidget#Sidebar {
    background: #FFFFFF;
    border: none;
    border-right: 1px solid #EAEAEA;
    color: #666666;
    padding: 8px 0;
    outline: none;
}
QListWidget#Sidebar::item {
    padding: 12px 16px;
    border-radius: 6px;
    margin: 2px 8px;
    font-size: 14px;
    font-weight: 500;
    color: #666666;
    border: none;
}
QListWidget#Sidebar::item:hover {
    background: #F5F5F5;
    color: #000000;
}
QListWidget#Sidebar::item:selected {
    background: #F5F5F5;
    color: #000000;
    font-weight: 600;
}
QListWidget#Sidebar::item:focus {
    outline: none;
    border: none;
}

/* ── TopBar ──────────────────────────────────────────────────── */
QWidget#TopBar {
    background: #FFFFFF;
    border-bottom: 1px solid #EAEAEA;
    min-height: 64px;
    max-height: 64px;
}

/* ── Checkboxes ─────────────────────────────────────────────── */
QCheckBox {
    spacing: 10px;
    font-size: 14px;
    color: #000000;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #D4D4D4;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:hover {
    border-color: #000000;
}
QCheckBox::indicator:checked {
    background: #000000;
    border-color: #000000;
}

/* ── TabWidget ───────────────────────────────────────────────── */
QTabWidget::pane {
    background: #FFFFFF;
    border: 1px solid #EAEAEA;
    border-radius: 0 8px 8px 8px;
    padding: 4px;
}
QTabBar::tab {
    background: #FAFAFA;
    color: #666666;
    padding: 12px 20px;
    border-radius: 8px 8px 0 0;
    margin-right: 2px;
    font-weight: 500;
    font-size: 14px;
    border: 1px solid #EAEAEA;
    border-bottom: none;
}
QTabBar::tab:selected {
    background: #FFFFFF;
    color: #000000;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background: #F5F5F5;
    color: #000000;
}

/* ── Badges ──────────────────────────────────────────────────── */
QLabel#BadgeBlue {
    background: #D3E5FF;
    color: #0070F3;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#BadgeGreen {
    background: #D3F9E8;
    color: #0A8754;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#BadgeRed {
    background: #FFE5E5;
    color: #EE0000;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#BadgeAmber {
    background: #FFF4D6;
    color: #9A6700;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
}

/* ── Tooltips ────────────────────────────────────────────────── */
QToolTip {
    background: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ── Login page ──────────────────────────────────────────────── */
QWidget#LoginRoot {
    background-color: #000000;
}

QFrame#LoginCard {
    background: #FFFFFF;
    border: none;
    border-radius: 16px;
}

/* ── Dialog styling ──────────────────────────────────────────── */
QDialog {
    background: #FFFFFF;
    border-radius: 12px;
}

QDialog QLabel {
    background: transparent;
}

/* ── Message boxes ───────────────────────────────────────────── */
QMessageBox {
    background: #FFFFFF;
}
QMessageBox QLabel {
    color: #000000;
    font-size: 14px;
}
QMessageBox QPushButton {
    min-width: 80px;
}

/* ── Progress bar ────────────────────────────────────────────── */
QProgressBar {
    background: #EAEAEA;
    border: none;
    border-radius: 4px;
    height: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background: #000000;
    border-radius: 4px;
}

/* ── Dividers ────────────────────────────────────────────────── */
QFrame#Divider {
    background: #EAEAEA;
    max-height: 1px;
    min-height: 1px;
}

/* ── POS Scan Input ──────────────────────────────────────────── */
QLineEdit#ScanInput {
    font-size: 16px;
    font-weight: 500;
    padding: 16px 20px;
    min-height: 56px;
    border: 2px solid #000000;
    border-radius: 12px;
    background: #FFFFFF;
}
QLineEdit#ScanInput:focus {
    border: 2px solid #0070F3;
    background: #FFFFFF;
}

/* ── Cart Table ──────────────────────────────────────────────── */
QTableWidget#CartTable {
    background: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-size: 14px;
}
QTableWidget#CartTable::item {
    padding: 16px 12px;
    border-bottom: 1px solid #EAEAEA;
}
QTableWidget#CartTable QHeaderView::section {
    background: #FFFFFF;
    font-size: 12px;
    padding: 12px;
    border-bottom: 1px solid #EAEAEA;
}

/* ── Total Display ───────────────────────────────────────────── */
QLabel#TotalLarge {
    font-size: 48px;
    font-weight: 700;
    color: #000000;
    letter-spacing: -2px;
}

QLabel#TotalMedium {
    font-size: 32px;
    font-weight: 700;
    color: #000000;
    letter-spacing: -1px;
}

/* ── Stat Cards ──────────────────────────────────────────────── */
QFrame#StatCard {
    background: #FFFFFF;
    border: 1px solid #EAEAEA;
    border-radius: 12px;
}
