QWidget {
    background-color: #F5F7FA;
    color: #1F2937;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QLabel#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #0F172A;
}

QFrame#Card,
QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    margin-top: 10px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #1F2937;
    font-weight: 600;
}

QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QLineEdit, QComboBox, QSpinBox, QDateEdit, QTextEdit, QTableWidget {
    background: #FFFFFF;
    border: 1px solid #D5DEEA;
    border-radius: 10px;
    padding: 7px;
}

QListWidget {
    background: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 16px;
    color: #E2E8F0;
    padding: 8px;
}

QListWidget::item {
    padding: 10px;
    border-radius: 10px;
}

QListWidget::item:hover {
    background: #1E293B;
}

QListWidget::item:selected {
    background: #2563EB;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #EEF4FF;
    color: #1F2937;
    border: none;
    border-bottom: 1px solid #D6E2F5;
    padding: 8px;
    font-weight: 600;
}

QTableWidget {
    gridline-color: #E5E7EB;
    alternate-background-color: #F8FAFC;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
}
