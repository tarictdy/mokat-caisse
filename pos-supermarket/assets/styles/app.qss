/* ============================================================
   MOKAT MARKET POS - Vercel Dark Design System
   
   Palette:
     Background:   #0A0A0A (main), #171717 (surface), #262626 (elevated)
     Border:       #262626 (default), #404040 (hover)
     Text:         #FAFAFA (primary), #A1A1AA (secondary), #71717A (muted)
     Accent:       #0070F3 (blue), #22C55E (green), #EF4444 (red), #F59E0B (amber)
   ============================================================ */

/* -- Global Reset -- */
* {
    margin: 0;
    padding: 0;
}

QWidget {
    background-color: #0A0A0A;
    color: #FAFAFA;
    font-family: "Inter", "Segoe UI", -apple-system, sans-serif;
    font-size: 13px;
    selection-background-color: #1E40AF;
    selection-color: #FFFFFF;
}

QMainWindow, QDialog {
    background-color: #0A0A0A;
}

/* -- Scrollbars Minimal -- */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #404040;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #525252;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
}
QScrollBar::handle:horizontal {
    background: #404040;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #525252;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* -- Typography -- */
QLabel#PageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #FAFAFA;
    letter-spacing: -0.3px;
}

QLabel#SectionTitle {
    font-size: 11px;
    font-weight: 500;
    color: #71717A;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

/* -- Cards -- */
QFrame#Card {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 8px;
}

QGroupBox {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: 500;
    color: #FAFAFA;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    top: -2px;
    padding: 0 6px;
    color: #71717A;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    background: #171717;
}

/* -- Buttons Vercel Style -- */
QPushButton {
    background-color: #FAFAFA;
    color: #0A0A0A;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 500;
    min-height: 32px;
}
QPushButton:hover {
    background-color: #E5E5E5;
}
QPushButton:pressed {
    background-color: #D4D4D4;
}
QPushButton:disabled {
    background-color: #262626;
    color: #525252;
}

/* Secondary / Outlined */
QPushButton#SecondaryButton {
    background-color: transparent;
    color: #FAFAFA;
    border: 1px solid #404040;
}
QPushButton#SecondaryButton:hover {
    background-color: #262626;
    border-color: #525252;
}

/* Ghost */
QPushButton#GhostButton {
    background-color: transparent;
    color: #A1A1AA;
    border: none;
}
QPushButton#GhostButton:hover {
    background-color: #262626;
    color: #FAFAFA;
}

/* Danger */
QPushButton#DangerButton {
    background-color: #EF4444;
    color: #FFFFFF;
}
QPushButton#DangerButton:hover {
    background-color: #DC2626;
}

/* Success */
QPushButton#SuccessButton {
    background-color: #22C55E;
    color: #FFFFFF;
}
QPushButton#SuccessButton:hover {
    background-color: #16A34A;
}

/* Blue accent */
QPushButton#BlueButton {
    background-color: #0070F3;
    color: #FFFFFF;
}
QPushButton#BlueButton:hover {
    background-color: #0060D0;
}

/* -- Inputs -- */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTextEdit {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    color: #FAFAFA;
    min-height: 32px;
}
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover {
    border-color: #404040;
}
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTextEdit:focus {
    border: 1px solid #FAFAFA;
    background: #171717;
}
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    background: #0A0A0A;
    color: #525252;
    border-color: #262626;
}
QLineEdit::placeholder {
    color: #525252;
}

QComboBox::drop-down {
    border: none;
    padding-right: 10px;
    width: 20px;
}
QComboBox QAbstractItemView {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 6px;
    selection-background-color: #262626;
    selection-color: #FAFAFA;
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    min-height: 28px;
}
QComboBox QAbstractItemView::item:hover {
    background: #262626;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button,
QDateEdit::up-button,
QDateEdit::down-button {
    border: none;
    background: transparent;
    width: 16px;
}

/* -- Tables -- */
QTableWidget {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 6px;
    gridline-color: #262626;
    alternate-background-color: #1A1A1A;
    selection-background-color: #262626;
    selection-color: #FAFAFA;
    font-size: 13px;
    outline: none;
}
QTableWidget::item {
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #262626;
}
QTableWidget::item:selected {
    background-color: #262626;
    color: #FAFAFA;
}
QTableWidget::item:hover {
    background-color: #1F1F1F;
}

QHeaderView::section {
    background-color: #171717;
    color: #71717A;
    border: none;
    border-bottom: 1px solid #262626;
    padding: 10px 12px;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

QTableWidget QTableCornerButton::section {
    background: #171717;
    border: none;
}

/* -- Sidebar Vercel Dark -- */
QListWidget#Sidebar {
    background: #0A0A0A;
    border: none;
    border-right: 1px solid #262626;
    color: #A1A1AA;
    padding: 4px 0;
    outline: none;
}
QListWidget#Sidebar::item {
    padding: 10px 12px;
    border-radius: 6px;
    margin: 1px 6px;
    font-size: 13px;
    font-weight: 500;
    color: #A1A1AA;
    border: none;
}
QListWidget#Sidebar::item:hover {
    background: #262626;
    color: #FAFAFA;
}
QListWidget#Sidebar::item:selected {
    background: #262626;
    color: #FAFAFA;
}
QListWidget#Sidebar::item:focus {
    outline: none;
    border: none;
}

/* -- TopBar -- */
QWidget#TopBar {
    background: #0A0A0A;
    border-bottom: 1px solid #262626;
    min-height: 48px;
    max-height: 48px;
}

/* -- Checkboxes -- */
QCheckBox {
    spacing: 8px;
    font-size: 13px;
    color: #FAFAFA;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #404040;
    border-radius: 4px;
    background: #171717;
}
QCheckBox::indicator:hover {
    border-color: #FAFAFA;
}
QCheckBox::indicator:checked {
    background: #FAFAFA;
    border-color: #FAFAFA;
}

/* -- TabWidget -- */
QTabWidget::pane {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 0 6px 6px 6px;
    padding: 4px;
}
QTabBar::tab {
    background: #0A0A0A;
    color: #71717A;
    padding: 10px 16px;
    border-radius: 6px 6px 0 0;
    margin-right: 2px;
    font-weight: 500;
    font-size: 13px;
    border: 1px solid #262626;
    border-bottom: none;
}
QTabBar::tab:selected {
    background: #171717;
    color: #FAFAFA;
}
QTabBar::tab:hover:!selected {
    background: #171717;
    color: #FAFAFA;
}

/* -- Badges -- */
QLabel#BadgeBlue {
    background: #1E3A5F;
    color: #60A5FA;
    padding: 3px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 500;
}
QLabel#BadgeGreen {
    background: #14532D;
    color: #4ADE80;
    padding: 3px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 500;
}
QLabel#BadgeRed {
    background: #450A0A;
    color: #F87171;
    padding: 3px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 500;
}
QLabel#BadgeAmber {
    background: #451A03;
    color: #FBBF24;
    padding: 3px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 500;
}

/* -- Tooltips -- */
QToolTip {
    background: #262626;
    color: #FAFAFA;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* -- Login page -- */
QWidget#LoginRoot {
    background-color: #0A0A0A;
}

QFrame#LoginCard {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 12px;
}

/* -- Dialog styling -- */
QDialog {
    background: #171717;
    border-radius: 8px;
}

QDialog QLabel {
    background: transparent;
}

/* -- Message boxes -- */
QMessageBox {
    background: #171717;
}
QMessageBox QLabel {
    color: #FAFAFA;
    font-size: 13px;
}
QMessageBox QPushButton {
    min-width: 70px;
}

/* -- Progress bar -- */
QProgressBar {
    background: #262626;
    border: none;
    border-radius: 3px;
    height: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background: #FAFAFA;
    border-radius: 3px;
}

/* -- Dividers -- */
QFrame#Divider {
    background: #262626;
    max-height: 1px;
    min-height: 1px;
}

/* -- POS Scan Input -- */
QLineEdit#ScanInput {
    font-size: 14px;
    font-weight: 500;
    padding: 12px 16px;
    min-height: 44px;
    border: 1px solid #404040;
    border-radius: 8px;
    background: #171717;
}
QLineEdit#ScanInput:focus {
    border: 1px solid #0070F3;
    background: #171717;
}

/* -- Cart Table -- */
QTableWidget#CartTable {
    background: #171717;
    border: none;
    border-radius: 6px;
    font-size: 13px;
}
QTableWidget#CartTable::item {
    padding: 12px 10px;
    border-bottom: 1px solid #262626;
}
QTableWidget#CartTable QHeaderView::section {
    background: #171717;
    font-size: 11px;
    padding: 10px;
    border-bottom: 1px solid #262626;
}

/* -- Total Display -- */
QLabel#TotalLarge {
    font-size: 36px;
    font-weight: 700;
    color: #FAFAFA;
    letter-spacing: -1px;
}

QLabel#TotalMedium {
    font-size: 24px;
    font-weight: 600;
    color: #FAFAFA;
    letter-spacing: -0.5px;
}

/* -- Stat Cards -- */
QFrame#StatCard {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 8px;
}
